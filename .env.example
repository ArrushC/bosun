# Bosun — environment configuration.
# Copy to `.env` (in this directory) and adjust. Everything is optional.
# Runtime preferences (provider choice, concurrency, roles, permissions) are
# edited in the UI under Settings and stored in the database, not here.

# --- Server -------------------------------------------------------------------
# Bind address. Keep 127.0.0.1: Bosun can execute code on this machine.
BOSUN_HOST=127.0.0.1
BOSUN_PORT=8787
# Exposing beyond localhost requires BOTH of these (bearer token on every request).
# BOSUN_ALLOW_REMOTE=false
# BOSUN_AUTH_TOKEN=
# Extra browser origins allowed to call the API (the Vite dev server is always allowed).
# BOSUN_ALLOWED_ORIGINS=["http://my-host:5173"]

# --- Storage ------------------------------------------------------------------
# SQLite database, run worktrees and demo data live here (default: .data in this folder).
# BOSUN_DATA_DIR=/home/you/.local/share/bosun
# BOSUN_DATABASE_URL=sqlite+aiosqlite:////absolute/path/bosun.db

# Directory registered as the first workspace on a fresh database.
# Default: the directory you launched Bosun from, unless that is inside this
# folder (as with `make dev` / `make start`); then none is registered.
# BOSUN_INITIAL_WORKSPACE=/home/you/code/my-project

# Folder holding your projects; the workspace picker starts browsing here.
# With Docker it is also the folder mounted into the container.
# BOSUN_PROJECTS_DIR=/home/you/code

# --- Claude -------------------------------------------------------------------
# By default agents run on your Claude subscription through your existing
# Claude Code login (`claude auth login`). Inherited ANTHROPIC_API_KEY /
# Vertex variables are blanked for subscription runs so they cannot cause
# billed API usage, and any session that authenticates differently is stopped.

# Path to the Claude Code CLI. Default: the CLI bundled with claude-agent-sdk.
# BOSUN_CLAUDE_CLI_PATH=/home/you/.local/bin/claude

# Only used when you select "Anthropic API key" as the provider in Settings.
# BOSUN_ANTHROPIC_API_KEY=sk-ant-...

# Only used when you select "Google Vertex AI" in Settings (needs ADC:
# `gcloud auth application-default login`). Can also be set in Settings.
# BOSUN_VERTEX_PROJECT_ID=my-gcp-project
# BOSUN_VERTEX_REGION=global

# --- GitHub -------------------------------------------------------------------
# Default: the token from the GitHub CLI (`gh auth login`). Set this to use a
# fine-grained, read-only token instead. It is never stored in the database.
# The Docker image has no GitHub CLI, so set it there.
# BOSUN_GITHUB_TOKEN=github_pat_...
# BOSUN_GITHUB_API_URL=https://api.github.com

# --- Logging ------------------------------------------------------------------
BOSUN_LOG_LEVEL=INFO
# BOSUN_LOG_JSON=false

# --- Docker (docker compose) ----------------------------------------------------
# Read by compose.yaml; `make docker-setup` fills these in (and BOSUN_PROJECTS_DIR).
# Where the container keeps its database and run worktrees. Mounted at the same path.
# BOSUN_DOCKER_DATA_DIR=/home/you/.local/share/bosun
# Your user and group IDs (`id -u`, `id -g`), so files Bosun writes stay yours.
# BOSUN_UID=1000
# BOSUN_GID=1000
# Extra Debian packages for the projects your agents work on (rebuild after changing).
# BOSUN_EXTRA_APT_PACKAGES=build-essential golang
